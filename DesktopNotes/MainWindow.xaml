<Window x:Class="DesktopNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotionDesk Notes" Height="640" Width="440" MinWidth="320" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="False"
        AllowDrop="True"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <!-- Тонкий скроллбар в стиле Notion -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Background="#363636">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки панели Notion -->
        <Style x:Key="NotionToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ResizeGrip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
    </Window.Resources>

    <!-- Основная карточка (Строгий Notion Dark Style без лишних теней) -->
    <Border x:Name="MainCardBorder" CornerRadius="10" Background="#191919" BorderBrush="#2C2C2C" BorderThickness="1" Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель (Header) -->
            <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="11,11,0,0" BorderBrush="#292929" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid Margin="10,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Кнопка Новая заметка (+) -->
                        <Button x:Name="BtnNewNote" Click="NewNote_Click" Style="{StaticResource NotionToolBtn}" Content="+" Width="22" Height="22" Margin="0,0,6,0"/>

                        <Border Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                            <TextBlock x:Name="FileExtBadge" Text="TXT" FontWeight="SemiBold" FontSize="9" Foreground="#999999" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock x:Name="FileNameTitle" Text="Выберите заметку (txt или md)" FontWeight="Medium" FontSize="11" Foreground="#E2E2E2" VerticalAlignment="Center" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Выбор файла -->
                        <Button x:Name="BtnChooseFile" Click="ChooseFile_Click" Style="{StaticResource NotionToolBtn}" Content="📁"/>
                        <!-- Блокнот -->
                        <Button x:Name="BtnOpenFile" Click="OpenFile_Click" Style="{StaticResource NotionToolBtn}" Content="📝"/>
                        <!-- Пин (Always on top) -->
                        <Button x:Name="PinBtn" Click="TogglePin_Click" Style="{StaticResource NotionToolBtn}" Content="📌"/>
                        <!-- Язык (RU / EN) -->
                        <Button x:Name="LangBtn" Click="ToggleLang_Click" Style="{StaticResource NotionToolBtn}" Content="RU"/>
                        <!-- Шрифт (Mono / Clean) -->
                        <Button x:Name="FontBtn" Click="ToggleFont_Click" Style="{StaticResource NotionToolBtn}" Content="Aa"/>
                        <!-- Закрыть -->
                        <Button x:Name="BtnClose" Click="Close_Click" Content="✕" Background="Transparent" Foreground="#666666" BorderThickness="0" Width="20" Height="22" Cursor="Hand" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Центральный контейнер с поддержкой выделения текста -->
            <RichTextBox x:Name="DocViewer" Grid.Row="1"
                         IsReadOnly="True" IsDocumentEnabled="True"
                         IsUndoEnabled="False"
                         AllowDrop="False"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#D8D8D8"
                         FontFamily="Segoe UI, Segoe UI Emoji"
                         Padding="12,10,6,6"
                         TextOptions.TextFormattingMode="Display"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         SelectionBrush="#40FFFFFF">
            </RichTextBox>

            <!-- Нижняя панель состояния с пагинацией и уголком ресайза -->
            <Border Grid.Row="2" Background="#141414" CornerRadius="0,0,11,11" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="8,0,4,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Пагинация: кнопка Назад ◀ -->
                        <Button x:Name="BtnPrevPage" Click="PrevPage_Click" Style="{StaticResource NotionToolBtn}" Content="◀" Width="22" Height="20" Padding="0" Margin="0,0,2,0"/>
                        
                        <!-- Индикатор: 1 / 5 -->
                        <TextBlock x:Name="PageIndicatorText" Text="1 / 1" Foreground="#999999" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,3,0" FontFamily="Segoe UI"/>
                        
                        <!-- Пагинация: кнопка Вперед ▶ -->
                        <Button x:Name="BtnNextPage" Click="NextPage_Click" Style="{StaticResource NotionToolBtn}" Content="▶" Width="22" Height="20" Padding="0" Margin="0,0,8,0"/>

                        <!-- Имя текущего файла -->
                        <TextBlock x:Name="FooterFileName" Text="антигравити.txt" Foreground="#555555" FontSize="9.5" VerticalAlignment="Center" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    </StackPanel>

                    <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                </Grid>
            </Border>

            <!-- Интерактивный Drop-оверлей на 100% площади окна -->
            <Border x:Name="DragOverlay" Grid.RowSpan="3"
                    Background="#F0191919" CornerRadius="11"
                    BorderBrush="#38BDF8" BorderThickness="2"
                    Visibility="Collapsed" IsHitTestVisible="True"
                    AllowDrop="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DragOverlayLabel" Text="Отпустите файл или папку сюда"
                               Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock Text="(.md, .txt или папка с заметками)"
                               Foreground="#888888" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
